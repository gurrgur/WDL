{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug REAPER replacement libSwell.so",
      "type": "cppdbg",
      "request": "launch",

      "program": "/usr/lib/REAPER/reaper",
      "args": [],

      "cwd": "${workspaceFolder}",

      "MIMode": "gdb",

      "pipeTransport": {
        "pipeProgram": "/usr/bin/bwrap",
        "pipeArgs": [
          "--bind", "/", "/",

          "--bind", "${workspaceFolder}/WDL/swell2/build/libSwell.so", "/usr/lib/REAPER/libSwell.so",

          "--bind", "${env:HOME}/.config/REAPER", "${env:HOME}/.config/REAPER",
          "--bind", "${env:HOME}/.cache", "${env:HOME}/.cache",

          "--tmpfs", "/tmp",

          "--dev", "/dev",
          "--dev-bind-try", "/dev/dri", "/dev/dri",
          "--proc", "/proc",
          "--cap-add", "CAP_SYS_PTRACE",

          "--"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },

      "stopAtEntry": false,

      "setupCommands": [
  {
    "text": "set pagination off",
    "ignoreFailures": true
  },
  {
    "text": "set breakpoint pending on",
    "ignoreFailures": true
  },
  {
    "text": "set print thread-events on",
    "ignoreFailures": true
  },
  {
    "text": "set auto-load safe-path /",
    "ignoreFailures": true
  },
  {
    "text": "set libthread-db-search-path /usr/lib:/lib:/lib64:/usr/lib64:/usr/lib/x86_64-linux-gnu",
    "ignoreFailures": true
  },
  {
    "text": "set solib-search-path ${workspaceFolder}/build",
    "ignoreFailures": true
  },
  {
    "text": "sharedlibrary libSwell",
    "ignoreFailures": true
  },
  {
    "text": "-enable-pretty-printing",
    "ignoreFailures": true
  }
],

      "logging": {
        "engineLogging": true
      },
      "environment": [
        {
          "name": "SDL_VIDEO_DRIVER",
          "value": "x11"
        },
        {
          "name": "SDL_VIDEODRIVER",
          "value": "x11"
        }
      ]
    }
  ]
}